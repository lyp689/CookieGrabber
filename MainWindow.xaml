<Window x:Class="CookieGrabber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="网站 Cookies 获取工具" Height="820" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 地址栏工具栏 -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnBack" Grid.Column="0" Content="←" Width="38" Height="30"
                        Margin="0,0,4,0" Click="BtnBack_Click"/>
                <Button x:Name="BtnForward" Grid.Column="1" Content="→" Width="38" Height="30"
                        Margin="0,0,4,0" Click="BtnForward_Click"/>
                <Button Grid.Column="2" Content="⟳" Width="38" Height="30"
                        Margin="0,0,8,0" Click="BtnRefresh_Click"/>

                <TextBox x:Name="AddressBar" Grid.Column="3" Height="30" VerticalContentAlignment="Center"
                         Padding="8,0" KeyDown="AddressBar_KeyDown"/>

                <Button Grid.Column="4" Content="访问" Width="70" Height="30"
                        Margin="8,0,0,0" Click="BtnGo_Click"/>
            </Grid>
        </Border>

        <!-- 内嵌浏览器 -->
        <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>

        <!-- 操作按钮区 -->
        <Border Grid.Row="2" Background="#FAFAFA" Padding="8" BorderBrush="#DDD" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnGrab" Content="获取 Cookies" Height="32" Padding="16,0"
                        FontWeight="Bold" Click="BtnGrabCookies_Click"/>
                <Button Content="复制请求头" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Click="BtnCopyHeader_Click"/>
                <Button Content="导出 JSON" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Click="BtnExportJson_Click"/>
                <Button Content="导出 Netscape" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Click="BtnExportNetscape_Click"/>
                <Button Content="清空" Height="32" Padding="16,0" Margin="8,0,0,0"
                        Click="BtnClear_Click"/>

                <CheckBox x:Name="ChkOnlyCurrent" Content="仅当前域名" IsChecked="True"
                          VerticalAlignment="Center" Margin="20,0,0,0"/>

                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="20,0,0,0"
                           Foreground="#666"/>
            </StackPanel>
        </Border>

        <!-- Cookies 列表 -->
        <DataGrid Grid.Row="3" x:Name="CookieGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  RowHeight="24" FontSize="12" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160"/>
                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*"/>
                <DataGridTextColumn Header="域" Binding="{Binding Domain}" Width="180"/>
                <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="80"/>
                <DataGridTextColumn Header="过期时间" Binding="{Binding ExpiresText}" Width="150"/>
                <DataGridCheckBoxColumn Header="Secure" Binding="{Binding Secure}" Width="70"/>
                <DataGridCheckBoxColumn Header="HttpOnly" Binding="{Binding HttpOnly}" Width="80"/>
                <DataGridTextColumn Header="SameSite" Binding="{Binding SameSite}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Padding="8,4" Foreground="#888" FontSize="11"
                   Text="提示：登录状态保存在本地用户数据目录，下次打开无需重复登录。"/>
    </Grid>
</Window>
